# Copy to /etc/default/report-ai-portal and chmod 0600.
STUDY_NAME=Indo-VAP
REPORT_AI_PROXY_SHARED_SECRET=replace-with-a-long-random-secret
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_MAX_TURNS=12

# ── PHI-safety / production controls ──────────────────────────────────────────
# Production deployments should run fail-closed. REPORT_AI_PRODUCTION=1 makes
# production_mode_enabled() True, which (a) requires the PHI log redactor key to
# be configured at startup and (b) forces the disabled-scrub floor to raise even
# in a test context. Enable it here only once the redactor key is provisioned.
REPORT_AI_PRODUCTION=1
# Proxy auth mode pairs with REPORT_AI_PROXY_SHARED_SECRET above (also satisfies
# production_mode_enabled()).
REPORT_AI_AUTH_MODE=proxy
# Host publish pipeline only (NOT the chat service): set to 1 to restore strict
# fail-closed abort on the first un-scrubbable row. Unset/absent = partial-publish
# -on-review (publish each form's clean rows, quarantine only the bad ones).
# REPORTAL_SCRUB_STRICT_ABORT=0
# NOTE: never set REPORTALIN_ALLOW_DISABLED_SCRUB in production — its mere presence
# hard-fails the publish wrapper, and the scrub floor ignores it outside pytest.
